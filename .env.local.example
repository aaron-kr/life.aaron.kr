# Copy this file to .env.local for local development:
#   cp .env.local.example .env.local
# .env.local is gitignored and never committed. In production, set these same
# keys in Vercel → Project Settings → Environment Variables instead.

# ── Firebase (Web app config — safe to expose client-side, these are not secrets) ──
# console.firebase.google.com → Project Settings → Your apps → SDK setup and config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The only Google account allowed to sign in to this dashboard. Must exactly
# match the email in firestore.rules.
NEXT_PUBLIC_ALLOWED_EMAIL=

# ── Weather (OpenWeatherMap free tier) ───────────────────────────────────────
# Get a free key at https://openweathermap.org/api — server-side only, never
# exposed to the browser (no NEXT_PUBLIC_ prefix).
OPENWEATHER_API_KEY=

# Course schedule sources (one raw GitHub YAML link per course) live in
# _data/course-sources.yml, not here — edit that file directly, no env var
# or redeploy needed beyond a normal git push.
